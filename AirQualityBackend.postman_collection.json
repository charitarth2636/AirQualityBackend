  },
  "item": [
    {
      "name": "Check Server",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/signup",
        "urlencoded": [
          { "key": "username", "value": "testuser" },
          { "key": "email", "value": "test@gmail.com" },
          { "key": "password", "value": "1234" }
        ]
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "urlencoded": [
          { "key": "username", "value": "testuser" },
          { "key": "password", "value": "1234" }
        ]
      }
    },
    {
      "name": "Forecast",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/forecast?lat=23.0225&lon=72.5714"
      }
    }
